apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: inference-blue
  annotations:
    nginx.ingress.kubernetes.io/rewrite-target: /
spec:
  ingressClassName: nginx
  rules:
  - host: inference.local
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: inference-svc
            port:
              number: 80

